import {
  activate,
  call,
  init,
  kinds,
  methods,
  normalize_inbound,
  payload_schema,
  provider_id,
  shutdown,
} from "../src/lib"

/** Read a fixture JSON body from the test fixtures directory. */
pub fn fixture_body(fs: HarnessFs, name: any) -> string {
  return fs.read_text(fs.source_dir() + "/fixtures/webhooks/" + name + ".json")
}

/**
 * Compute a `Stripe-Signature` header value for a body.
 *
 * The signed message is `"<timestamp>.<raw_body>"`, HMAC-SHA256 keyed by the
 * endpoint signing secret. Mirrors `__verify_signature` in src/lib.harn.
 */
pub fn sign(secret: any, body: any, timestamp: any) -> string {
  const v1 = hmac_sha256(to_string(secret), to_string(timestamp) + "." + body)
  return "t=" + to_string(timestamp) + ",v1=" + v1
}

/** Current unix timestamp as an integer (within the freshness window). */
pub fn now_ts(clock: HarnessClock) -> int {
  return to_int(clock.timestamp())
}

/** Build a raw inbound envelope signed with the Stripe-Signature scheme. */
pub fn signed_raw(clock: HarnessClock, secret: any, body: any, timestamp: any = nil) {
  const ts = timestamp ?? now_ts(clock)
  return {body_text: body, headers: {"stripe-signature": sign(secret, body, ts)}}
}

/** Build a signed raw inbound envelope from a named fixture. */
pub fn fixture_raw(
  harness: {clock: HarnessClock, fs: HarnessFs},
  name: any,
  secret: any,
  timestamp: any = nil,
) {
  return signed_raw(harness.clock, secret, fixture_body(harness.fs, name), timestamp)
}

pub fn assert_stripe_interface(harness: Harness) {
  shutdown(harness)
  require provider_id() == "stripe", "provider id"
  require kinds()[0] == "webhook", "webhook kind"
  require payload_schema().harn_schema_name == "StripeEventPayload", "payload schema name"
  const mutate = __method_meta(methods(), "customer.create")
  require mutate.requires_approval, "customer.create requires approval"
  const read = __method_meta(methods(), "customer.get")
  require !read.requires_approval, "customer.get does not require approval"
  const passthrough = __method_meta(methods(), "api.request")
  require !passthrough.requires_approval, "api.request does not require approval"
  const initialized = init(harness, {webhook_secret: "whsec_test"})
  require initialized.initialized, "init stores state"
  const activated = activate(
    harness,
    [{id: "primary", path: "/stripe/events", secrets: {webhook_secret: "whsec_test"}}],
  )
  require activated.bindings == 1, "activate counts bindings"
}

fn __method_meta(method_list: any, name: any) {
  for entry in method_list {
    if entry.name == name {
      return entry
    }
  }
  return {name: name, requires_approval: false}
}

pub fn stripe_call(harness: Harness, method: any, args: any) {
  return call(harness, method, args)
}

pub fn stripe_normalize(harness: Harness, raw: any) {
  return normalize_inbound(harness, raw)
}
